---
import Layout from "../layouts/layout.astro";
import Card from "../components/Card";
import ProjectList from "../components/ProjectList";
import type Project from "../types/project";
import { MECHANIC_PLUS_PROJECT } from "../constants";

async function getProjects() {
  try {
    const response = await fetch(
      "https://api.github.com/users/SyntaxBreaker/repos",
    );
    const projects: Project[] = await response.json();

    const projectNames = ["self-discover", "trackhub", "twitch-chat"];

    return projects.filter(({ name }) => projectNames.includes(name));
  } catch (error) {
    console.error("Failed to fetch projects:", error);
    return [];
  }
}

const projects = await getProjects();
const selectedProjects = [MECHANIC_PLUS_PROJECT, ...projects];
---

<Layout title="SyntaxBreaker Projects">
  <Card title="Projects" description="You can see my projects below." />
  <ProjectList projects={selectedProjects} />
</Layout>
