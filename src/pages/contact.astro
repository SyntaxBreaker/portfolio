---
import Layout from "../layouts/layout.astro";
import Card from "../components/Card";
import ContactForm from "../components/ContactForm";
import SocialProfiles from "../components/SocialProfiles";
---

<Layout
  title="SyntaxBreaker Contact"
  description="Have a project in mind or want to collaborate? Get in touch with me today. Let's build something great together. I'm always open to new opportunities!"
  keywords="contact, get in touch, freelance, collaboration, hiring"
>
  <Card
    title="Contact"
    description="Are you interested in collaborating? Your messages are always welcome, so feel free to contact me anytime!"
  />
  <section style="display: flex; flex-wrap: wrap; gap: 32px">
    <ContactForm client:load />
    <SocialProfiles />
  </section>
</Layout>
