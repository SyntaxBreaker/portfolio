---
import Layout from "../layouts/layout.astro";
import Card from "../components/Card";
import ContactForm from "../components/ContactForm";
import SocialProfiles from "../components/SocialProfiles";
---

<Layout
  title="Contact | Work with SyntaxBreaker"
  description="Looking for a developer who can design and build your next project? Get in touch with SyntaxBreaker."
  keywords="Hire Full-stack Developer, Contact Web Designer, SyntaxBreaker Contact, Freelance Developer, Hire UI/UX Designer"
>
  <Card
    title="Contact"
    description="Are you interested in collaborating? Your messages are always welcome, so feel free to contact me anytime!"
  />
  <section style="display: flex; flex-wrap: wrap; gap: 32px">
    <ContactForm client:load />
    <SocialProfiles />
  </section>
</Layout>
